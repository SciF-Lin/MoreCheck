<?xml version="1.0" encoding="utf-8"?>
<!--
    「图标更改」新增：五角星 ★ 那套自适应图标（v1.1.69 需求 2b）。

    结构、坐标系与安全区的取舍与 `ic_launcher_check.xml` 完全一致，
    见那个文件的注释与本目录四个 `@drawable/ic_icon_fore_*` 的 KDoc。

    背景 `@color/ic_launcher_star_background`（`#37474F`，Material Blue Grey 800）：
    做成**中性深灰**是刻意的——其余各套都在用色相说话，
    星标用无彩色深底既不与任何一套撞色，又和纯黑的默认那套拉开了明度差。
    与纯白前景的对比度约 10 : 1，是所有套里最高的，小尺寸下最稳。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_star_background" />
    <foreground android:drawable="@drawable/ic_icon_fore_star" />
</adaptive-icon>
