<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ notification permission (runtime request). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ exact alarm permission for daily reminders. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule reminders after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 「扫一扫」需要相机（运行时申请）。这是该功能唯一的硬件权限。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 「搜一搜」内嵌网页与云同步需要联网。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 联网失败时区分「没网」与「服务出错」。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        「记事本 → 悬浮窗」需要把内容画在别的应用之上（v1.1.68 需求 2）。
        这是**特殊权限**，不能用运行时对话框申请，只能跳系统设置页让用户手动开
        （见 `ui/lab/NotebookOverlayService.kt` 里 `NotebookOverlay.open` 的说明）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        前台 Service 权限（「记事本 → 悬浮窗」用）。

        ## 为什么必须有 FOREGROUND_SERVICE
        Android 9+（API 28）起，声明了 `foregroundServiceType` 的服务若没有这个权限，
        调 `startForeground` 会抛 `SecurityException`。

        ## 为什么还需要 FOREGROUND_SERVICE_SPECIAL_USE
        Android 14+（API 34）起，前台服务必须声明**类型**，且每种类型对应一个独立权限。
        本功能不属于任何平台预置类型（不是媒体播放、不是定位、不是数据同步），
        平台为这种情形提供的出口就是 `specialUse`。

        ⚠️ 取舍与风险（已知并接受）：`specialUse` 在 **Google Play 上架时需要提交用途说明
        并接受审核**。本项目是自用 / 内部分发（见 `dist/install.ps1`），不走 Play 审核流程，
        因此用它最贴切。若将来上架被拒，替代方案是语义牵强的 `dataSync`（同样要审核），
        或把悬浮窗降级为"与 Activity 同生命周期"——两者都不如现在干净。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- 没有相机的设备（少数模拟器/平板）仍可安装，扫码入口会给出提示而不是崩溃。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- 定位同理：没有 GPS 的设备仍可安装，天气会退化为「无法定位」提示。 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".MoreCheckApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoreCheck">

        <!--
            ⚠️ 本 Activity **刻意不再声明 LAUNCHER intent-filter**（需求：图标更改）。

            桌面图标改由下面 4 个 `activity-alias` 提供，每个 alias 一套内置图标；
            `.MainActivity` 自己若还留着 LAUNCHER 过滤器，桌面就会**同时出现两个图标**
            （真实 Activity 一个 + 当时启用的 alias 一个），这正是「图标测试」最典型的翻车方式。
            所以 LAUNCHER 过滤器整体搬到 alias 上，本 Activity 只剩「被 alias 拉起」这一个角色。

            ⚠️ 但 `android:exported="true"` **必须保留**，这不是可选项：

            `dist/install.ps1` 用 `am start -n com.morecheck/.MainActivity` 在装完后启动应用。
            `am` 是**以 shell 身份**发起的跨应用启动，属于外部调用；
            组件未导出时会被系统直接拒绝
            （`Permission Denial: starting Intent { ... } not exported from uid ...`），
            安装脚本最后那一步就会失败。所以这里「去掉 LAUNCHER 过滤器」与
            「去掉 exported」是**两件完全不同的事**，前者是需求，后者会让 CI 脚本挂掉。

            `android:label` / `android:theme` 保留在 Activity 上：`makeAlias()` 会把这两项
            继承给 alias。下面每个 alias **仍然显式写了 `android:label`**：
            它让每个 alias 自解释（不必回头去 Activity 上确认应用名是什么），
            也防止日后有人把 label 从 Activity 上拿掉、导致桌面图标突然没名字。
            `android:theme` 则**不重复**——alias 上写 theme 没有任何额外作用，
            只是把同一个值放到了两处。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoreCheck"
            android:windowSoftInputMode="adjustResize" />

        <!--
            ── windowSoftInputMode 为什么必须显式写 adjustResize（v1.1.70）──────────

            ## 症状（真机 25060RK16C / HyperOS + 百度输入法小米版实测）

            智能体页点输入框，键盘弹出后**输入栏悬在屏幕中部**、与键盘之间空出
            近半屏——「输入框异常弹起过高」。三个版本换 inset 写法都治不了它
            （见 AgentChatScreen 的 ChatInputBar 注释），因为真正的根因在窗口层：

            ## 根因：pan 与 inset 双重补偿

            不写 windowSoftInputMode 时，该 ROM 对 edge-to-edge 窗口回落到
            **adjustPan**（dumpsys 实测 `sim={adjust=pan}`）。于是出现两条让位路径
            同时生效：
            ① adjustPan 把整个窗口向上平移（视觉上内容顶到状态栏后面）；
            ② 输入法窗口自身的 content inset（实测 1561px，几乎整屏——百度输入法
               小米版以全屏窗口 + 透明底实现，Compose 读到的 ime inset 就是这么大）
               又让 Compose 按 safeDrawing 再让一次位。
            平移之后 inset 依旧非零，两次补偿叠加，输入栏正好悬在键盘上方一大截。

            ## adjustResize 为什么是根治

            adjustResize 下系统**不再平移窗口**，让位完全走 insets 派发这一条路：
            Compose 的 `WindowInsets.ime` / `safeDrawing` 拿到的是唯一事实源，
            输入栏随键盘高度精确贴合，键盘收起后 inset 回落到导航栏高度，
            底部按钮也不会被导航条压住（v1.1.69 冒烟测试修的另一头）。
            上一版在 inset 写法上换三种方案都失败，正是因为没有关掉 pan 这条
            并行的旧路径——结构性消除坏状态，而不是按时机补偿（与 5.1 同一教训）。
        -->

        <!--
            ── 内置桌面图标（4 套，用 activity-alias 做真实切换）────────────────────────

            ## 为什么必须用 alias，而不能直接换 `android:icon`

            桌面图标是**写在 manifest 里的资源引用**，由系统 PackageManager 在安装 / 组件状态变更时
            解析并缓存。应用运行时**无法**把自己或某个 Activity 的图标改成一张新图片——
            这是 Android 的硬限制，没有任何 API 能覆盖它。
            于是「换图标」唯一可行的官方做法就是：**预先把几套图标都声明好**（每套一个 alias），
            运行时只切换**哪一个是启用的**（`PackageManager.setComponentEnabledSetting`），
            系统随即按当前启用的组件重新解析桌面图标。

            ⚠️ 这条限制也直接决定了需求里「自定义上传的图片」的边界：
            用户自传的图**永远不可能**成为桌面图标（它不是资源、没有资源 id），
            所以自传图只用做**应用内显示**（见 `data/AppIconRepository` 与 `ui/lab/IconPickerScreen`）。

            ## 四套图标

            - `.icon.Default`：**默认**，用现成的 `@mipmap/ic_launcher`（黑色底），
              与改造前的图标**逐字节相同**——「一键恢复默认」恢复的就是它，不能有一丝差别；
            - 蓝 / 紫 / 橙三套复用**同一个前景**（`drawable-xxxhdpi/ic_launcher_foreground.png`），
              只换自适应图标的**背景色**，色值取自应用主题色 `AccentColor` 里已有的蓝 `#1E88E5`、
              紫 `#7E57C2`、橙 `#FB8C00`。因此**不需要任何新的二进制图片资源**，
              也不可能出现「换了图标但前景画风不一致」的割裂。

            ## `enabled` 的初始值就是「默认那套」

            只有 `.icon.Default` 是 `enabled="true"`，其余三套 `enabled="false"`。
            这个「安装后的初始状态」必须与 `SettingsRepository` 里图标设置的默认值
            （`SettingsRepository.DEFAULT_ICON_STYLE` = `"default"`）**保持一致**，
            否则首次进页面会看到「选中的是蓝色、桌面上是默认图标」这种自相矛盾的回显。

            ## ⚠️ 每个 alias 都必须写 `android:roundIcon`

            已核对平台源码（`ParsedActivityUtils.parseActivityAlias` →
            `ParsedMainComponentUtils.parseMainComponent` → `ParsedComponentUtils.parseComponent`）：
            alias 的图标取自**它自己的属性数组**，逻辑是

            ```
            roundIconVal = useRoundIcon ? array.getResourceId(roundIconAttr, 0) : 0
            if (roundIconVal != 0) component.setIcon(roundIconVal)
            else if (iconVal != 0) component.setIcon(iconVal)
            ```

            也就是说：**alias 自己的 `roundIcon` 优先，其次才是 alias 自己的 `icon`**，
            两者都没写才会回落到 `makeAlias()` 从目标 `.MainActivity` 继承来的图标。
            所以这里只写 `icon` 不写 `roundIcon` 时，在**会查询 roundIcon 的桌面**上
            （三星、部分 EMUI/MIUI）并不会取到 alias 的 `icon`，而是回到继承来的那一个 ——
            表现为「应用内显示已切到蓝色，桌面还是默认图标」，会被当成切换失败。

            三套彩色 alias 的 `roundIcon` 直接**复用同一份自适应图标 XML**，
            而不是再建 `ic_launcher_blue_round.xml`：自适应图标本身就是
            「前景 + 背景」，由桌面按自己的形状（圆 / 方 / 水滴）去裁，
            圆形与方形两份文件内容会**逐字节相同**，多出来的文件只是重复。

            只有 `.icon.Default` 的 `roundIcon` 指向 `@mipmap/ic_launcher_round`，
            与改造前完全一致——恢复默认必须恢复到这个字节级相同的状态。

            ## `android:exported` 为什么必写

            targetSdk 31+ 起，**任何带 intent-filter 的组件**都必须显式声明 `android:exported`，
            否则安装期就会报 `android:exported needs to be explicitly specified`。
            alias 带了 LAUNCHER 过滤器，所以四个都写 `true`——它本来就是要被桌面拉起的。

            ⚠️ 标签一律用 `@string/app_name`：本功能只换**图标**，不改应用名。
            `theme` 则**有意不写**在 alias 上——`makeAlias()` 会把目标 `.MainActivity`
            的 theme 继承下来，重复声明只会让同一个值有两个来源。
        -->
        <activity-alias
            android:name=".icon.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Blue"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_blue"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_blue"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Purple"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_purple"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_purple"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Orange"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_orange"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_orange"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

