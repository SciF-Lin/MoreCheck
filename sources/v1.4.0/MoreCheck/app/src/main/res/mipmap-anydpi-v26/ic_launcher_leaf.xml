<?xml version="1.0" encoding="utf-8"?>
<!--
    「图标更改」新增：叶片那套自适应图标（v1.1.69 需求 2b）。

    结构、坐标系与安全区的取舍与 `ic_launcher_check.xml` 完全一致，
    见那个文件的注释与本目录四个 `@drawable/ic_icon_fore_*` 的 KDoc。

    背景 `@color/ic_launcher_leaf_background`（`#43A047`，Material Green 600）：
    绿是叶子的自然色。刻意**不用**应用默认主题色的绿 `#07C160`——
    那一个是偏亮的"消息绿"，白前景压上去只有约 2.0 : 1 的对比度，
    小尺寸下白色叶脉会糊掉；Green 600 深一档，同为绿但撑得住白色。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_leaf_background" />
    <foreground android:drawable="@drawable/ic_icon_fore_leaf" />
</adaptive-icon>
