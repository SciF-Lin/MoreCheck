<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_checkin_background"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_checkin_title"
        android:textColor="#333333"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#1D9E75"
        android:textSize="20sp"
        android:textStyle="bold"
        android:text="0 / 0" />

    <TextView
        android:id="@+id/widget_hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/widget_checkin_hint"
        android:textColor="#777777"
        android:textSize="11sp" />

    <Button
        android:id="@+id/widget_btn_checkin"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:text="@string/widget_checkin_button"
        android:textSize="13sp" />

</LinearLayout>
