<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 13+ notification permission (runtime request). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 12+ exact alarm permission for daily reminders. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-schedule reminders after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 「扫一扫」需要相机（运行时申请）。这是该功能唯一的硬件权限。 -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- 「实验室 → 天气」按需求用系统定位算当地天气（运行时申请）。 -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- 「官网」内嵌网页与「实验室 → 天气」查询需要联网。 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 联网失败时区分「没网」与「服务出错」。 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        「安装包下载」页把云端正式版 APK 下载完成后要拉起系统安装器（本轮需求 2）。

        缺了这条权限，`Intent.ACTION_VIEW` + apk 的 mime 会直接被 PackageInstaller 拒绝，
        logcat 里是 `InstallStart: Requesting uid … needs to declare permission
        android.permission.REQUEST_INSTALL_PACKAGES`，界面表现是"点了下载，什么都没发生"
        ——下载本身是成功的，文件也已落在 Download/MoreCheck/。

        这是**普通权限**（安装即授予，不弹对话框），但要真正装上一次，
        系统还会要求用户为"来自此来源的应用"打开安装开关（首次会有系统引导页）。
        本应用不通过应用商店分发，自更新必须走这条路。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
        「开屏密码」手势画错时短震一次（v1.1.92 需求）。
        普通权限，安装即授予、不弹运行时对话框；用户可在
        设置 → 安全 → 开屏密码 里关掉这个反馈。
    -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        「记事本 → 悬浮窗」需要把内容画在别的应用之上（v1.1.68 需求 2）。
        这是**特殊权限**，不能用运行时对话框申请，只能跳系统设置页让用户手动开
        （见 `ui/lab/NotebookOverlayService.kt` 里 `NotebookOverlay.open` 的说明）。
    -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!--
        前台 Service 权限（「记事本 → 悬浮窗」用）。

        ## 为什么必须有 FOREGROUND_SERVICE
        Android 9+（API 28）起，声明了 `foregroundServiceType` 的服务若没有这个权限，
        调 `startForeground` 会抛 `SecurityException`。

        ## 为什么还需要 FOREGROUND_SERVICE_SPECIAL_USE
        Android 14+（API 34）起，前台服务必须声明**类型**，且每种类型对应一个独立权限。
        本功能不属于任何平台预置类型（不是媒体播放、不是定位、不是数据同步），
        平台为这种情形提供的出口就是 `specialUse`。

        ⚠️ 取舍与风险（已知并接受）：`specialUse` 在 **Google Play 上架时需要提交用途说明
        并接受审核**。本项目是自用 / 内部分发（见 `dist/install.ps1`），不走 Play 审核流程，
        因此用它最贴切。若将来上架被拒，替代方案是语义牵强的 `dataSync`（同样要审核），
        或把悬浮窗降级为"与 Activity 同生命周期"——两者都不如现在干净。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!--
        音乐后台播放（2026-11-08）。

        ## 为什么是 MEDIA_PLAYBACK 而不是 specialUse
        媒体播放是 Android 14+ 预置的前台服务类型中**语义完全对口**的一个
        （`android:foregroundServiceType="mediaPlayback"`），对应的权限就是这条。
        悬浮窗那个服务必须用 specialUse 是因为它确实不对口；这里不该照抄。

        ## WAKE_LOCK 为什么也要
        `ExoPlayer.setWakeMode(C.WAKE_MODE_NETWORK)` 需要它：息屏后要继续拉音频流，
        没有 wake lock 系统会在灭屏不久把 CPU 挂起，表现为"锁屏后播几秒就停"。
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- 没有相机的设备（少数模拟器/平板）仍可安装，扫码入口会给出提示而不是崩溃。 -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <!-- 定位同理：没有 GPS 的设备仍可安装，天气会退化为「无法定位」提示。 -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />

    <application
        android:name=".MoreCheckApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MoreCheck">

        <!--
            ⚠️ 本 Activity **刻意不再声明 LAUNCHER intent-filter**（需求：图标更改）。

            桌面图标改由下面若干 `activity-alias` 提供，每个 alias 一套内置图标；
            `.MainActivity` 自己若还留着 LAUNCHER 过滤器，桌面就会**同时出现两个图标**
            （真实 Activity 一个 + 当时启用的 alias 一个），这正是「图标测试」最典型的翻车方式。
            所以 LAUNCHER 过滤器整体搬到 alias 上，本 Activity 只剩「被 alias 拉起」这一个角色。

            ⚠️ 但 `android:exported="true"` **必须保留**，这不是可选项：

            `dist/install.ps1` 用 `am start -n com.morecheck/.MainActivity` 在装完后启动应用。
            `am` 是**以 shell 身份**发起的跨应用启动，属于外部调用；
            组件未导出时会被系统直接拒绝
            （`Permission Denial: starting Intent { ... } not exported from uid ...`），
            安装脚本最后那一步就会失败。所以这里「去掉 LAUNCHER 过滤器」与
            「去掉 exported」是**两件完全不同的事**，前者是需求，后者会让 CI 脚本挂掉。

            `android:label` / `android:theme` 保留在 Activity 上：`makeAlias()` 会把这两项
            继承给 alias。下面每个 alias **仍然显式写了 `android:label`**：
            它让每个 alias 自解释（不必回头去 Activity 上确认应用名是什么），
            也防止日后有人把 label 从 Activity 上拿掉、导致桌面图标突然没名字。
             `android:theme` 则**不重复**——alias 上写 theme 没有任何额外作用，
            只是把同一个值放到了两处。

             ── launchMode 为什么必须是 singleTask（本轮需求 16/18/19）──────────

             症状（用户实机复现）：① 后台运行时再点桌面 App 图标，会反复跳回主页；
             ② 先点贪吃蛇快捷方式、再按 home、再点原 App 图标，「主页」会**覆盖在**
             贪吃蛇页之上，形成「贪吃蛇 → 主页」的嵌套栈；③ 应用已在后台时，
             桌面快捷方式点不开对应界面。

             三者的根因是同一个：`standard`（默认）模式下每次从桌面启动都会
             **新建一个 Activity 实例、压进同一个 task**，于是同一个页面栈里
             可能出现两套并行的 Compose 导航状态（各有一套 `NavController` 与
             `rememberSaveable`），表现为界面互相覆盖、返回键一层层剥。

             `singleTask` 的语义正好对上：**如果已经存在以本 Activity 为根的 task，
             就把那个 task 整体搬到前台，并把新 Intent 通过 onNewIntent 交给已有实例**，
             而不是新建实例。于是：
             · 后台运行时点 App 图标 = 复用已有 task → 停在用户离开时的页面
               （而不是从头开始 → 表现为"反复跳主页"）；
             · 快捷方式直达 → onNewIntent → `labShortcutTarget` 赋值 → 既有
               `LaunchedEffect` 消费 → 需求 19「后台也能打开对应界面」；
             · 永远只有一个实例 → 不存在两套并行导航栈 → 需求 18 的嵌套消失。

             ⚠️ 与 `documentLaunchMode="never"` 一起写才完整：
             targetSdk 36 下，若 Intent 带 `FLAG_ACTIVITY_NEW_DOCUMENT`，
             `none`（默认）会允许新建文档 task；显式声明 `never` 把这条也关掉，
             保证「本应用全局只有一个 task」这个不变量由 manifest 兜底，
             而不是依赖每个调用方都记得传 flag。

             ⚠️ 为什么不用 `singleInstance`：那会让本 Activity 独占一个 task、
             由它启动的其它 Activity 全被挤到新 task，而本应用是单 Activity
             架构（只有 `.MainActivity`），没有第二 Activity 需要共享 task——
             但 NotebookOverlayService 的系统悬浮窗、以及由本 Activity 拉起的
             系统选择器 / 相机都会受影响，`singleInstance` 的风险面比收益大。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MoreCheck"
            android:launchMode="singleTask"
            android:documentLaunchMode="never"
            android:windowSoftInputMode="adjustResize" />

        <!--
            ── windowSoftInputMode 为什么必须显式写 adjustResize（v1.1.70）──────────

            ## 症状（真机 25060RK16C / HyperOS + 百度输入法小米版实测）

            智能体页点输入框，键盘弹出后**输入栏悬在屏幕中部**、与键盘之间空出
            近半屏——「输入框异常弹起过高」。三个版本换 inset 写法都治不了它
            （见 AgentChatScreen 的 ChatInputBar 注释），因为真正的根因在窗口层：

            ## 根因：pan 与 inset 双重补偿

            不写 windowSoftInputMode 时，该 ROM 对 edge-to-edge 窗口回落到
            **adjustPan**（dumpsys 实测 `sim={adjust=pan}`）。于是出现两条让位路径
            同时生效：
            ① adjustPan 把整个窗口向上平移（视觉上内容顶到状态栏后面）；
            ② 输入法窗口自身的 content inset（实测 1561px，几乎整屏——百度输入法
               小米版以全屏窗口 + 透明底实现，Compose 读到的 ime inset 就是这么大）
               又让 Compose 按 safeDrawing 再让一次位。
            平移之后 inset 依旧非零，两次补偿叠加，输入栏正好悬在键盘上方一大截。

            ## adjustResize 为什么是根治

            adjustResize 下系统**不再平移窗口**，让位完全走 insets 派发这一条路：
            Compose 的 `WindowInsets.ime` / `safeDrawing` 拿到的是唯一事实源，
            输入栏随键盘高度精确贴合，键盘收起后 inset 回落到导航栏高度，
            底部按钮也不会被导航条压住（v1.1.69 冒烟测试修的另一头）。
            上一版在 inset 写法上换三种方案都失败，正是因为没有关掉 pan 这条
            并行的旧路径——结构性消除坏状态，而不是按时机补偿（与 5.1 同一教训）。
        -->

        <!--
            ── 内置桌面图标（用 activity-alias 做真实切换）────────────────────────

            ## 为什么必须用 alias，而不能直接换 `android:icon`

            桌面图标是**写在 manifest 里的资源引用**，由系统 PackageManager 在安装 / 组件状态变更时
            解析并缓存。应用运行时**无法**把自己或某个 Activity 的图标改成一张新图片——
            这是 Android 的硬限制，没有任何 API 能覆盖它。
            于是「换图标」唯一可行的官方做法就是：**预先把几套图标都声明好**（每套一个 alias），
            运行时只切换**哪一个是启用的**（`PackageManager.setComponentEnabledSetting`），
            系统随即按当前启用的组件重新解析桌面图标。

            ⚠️ 这条限制也直接决定了需求里「自定义上传的图片」的边界：
            用户自传的图**永远不可能**成为桌面图标（它不是资源、没有资源 id），
            所以自传图只用做**应用内显示**（见 `data/AppIconRepository` 与 `ui/lab/IconPickerScreen`）。

            ## 本轮：蓝 / 紫 / 橙三套已删除（需求：内置桌面图标删除蓝色紫色橙色）

            这三套曾是「同一前景 PNG + 三种背景色」的实现，本轮连同
            `res/values/colors.xml` 里的三个背景色资源、
            `AppIconRepository.BUILT_IN_ICON_IDS` 与 `IconPickerScreen` 的映射**四处一起删净**。
            ⚠️ 对曾把桌面图标切到这三套的用户：升级后系统会保留旧 alias 的启用状态，
            而新包里它已不存在 → 桌面图标回落到默认套（Android 对"启用的 alias 被移除"
            的处理），属可接受的一次性影响；`IconPickerScreen` 进页时的
            `repairIfNoIconEnabled()` 兜底自检也会把默认套修回来。

            ## `enabled` 的初始值就是「默认那套」

            只有 `.icon.Default` 是 `enabled="true"`，其余各套 `enabled="false"`。
            这个「安装后的初始状态」必须与 `SettingsRepository` 里图标设置的默认值
            （`SettingsRepository.DEFAULT_ICON_STYLE` = `"default"`）**保持一致**，
            否则首次进页面会看到「选中的是某一套、桌面上是默认图标」这种自相矛盾的回显。

            ## ⚠️ 每个 alias 都必须写 `android:roundIcon`

            已核对平台源码（`ParsedActivityUtils.parseActivityAlias` →
            `ParsedMainComponentUtils.parseMainComponent` → `ParsedComponentUtils.parseComponent`）：
            alias 的图标取自**它自己的属性数组**，逻辑是

            ```
            roundIconVal = useRoundIcon ? array.getResourceId(roundIconAttr, 0) : 0
            if (roundIconVal != 0) component.setIcon(roundIconVal)
            else if (iconVal != 0) component.setIcon(iconVal)
            ```

            也就是说：**alias 自己的 `roundIcon` 优先，其次才是 alias 自己的 `icon`**，
            两者都没写才会回落到 `makeAlias()` 从目标 `.MainActivity` 继承来的图标。
            所以这里只写 `icon` 不写 `roundIcon` 时，在**会查询 roundIcon 的桌面**上
            （三星、部分 EMUI/MIUI）并不会取到 alias 的 `icon`，而是回到继承来的那一个 ——
            表现为「应用内显示已切换，桌面还是默认图标」，会被当成切换失败。

            各套的 `roundIcon` 直接**复用同一份自适应图标 XML**，
            而不是再建 `ic_launcher_<id>_round.xml`：自适应图标本身就是
            「前景 + 背景」，由桌面按自己的形状（圆 / 方 / 水滴）去裁，
            圆形与方形两份文件内容会**逐字节相同**，多出来的文件只是重复。

            只有 `.icon.Default` 的 `roundIcon` 指向 `@mipmap/ic_launcher_round`，
            与改造前完全一致——恢复默认必须恢复到这个字节级相同的状态。

            ## `android:exported` 为什么必写

            targetSdk 31+ 起，**任何带 intent-filter 的组件**都必须显式声明 `android:exported`，
            否则安装期就会报 `android:exported needs to be explicitly specified`。
            alias 带了 LAUNCHER 过滤器，所以都写 `true`——它本来就是要被桌面拉起的。

            ⚠️ 标签一律用 `@string/app_name`：本功能只换**图标**，不改应用名。
            `theme` 则**有意不写**在 alias 上——`makeAlias()` 会把目标 `.MainActivity`
            的 theme 继承下来，重复声明只会让同一个值有两个来源。
        -->
        <activity-alias
            android:name=".icon.Default"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_round"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!--
            ── 新增四套内置图标（v1.1.69 需求 2b：手绘前景 + 新背景色）──────────────

            ## 与上面四套的关系

            上面四套是「一张前景 PNG + 四种背景色」；新增的四套是
            **四个手绘矢量前景 + 四个新背景色**，与它们并列、各占一个 alias
            （第九套「杉树」在下面单独一段）。
            为什么还是 alias 机制、`<application>` 的 `android:icon` 为什么不动：
            见本文件上方那段长注释（系统只认 manifest 里的图标资源，
            运行期唯一能改的只有"哪个组件是启用的"）。

            ## 四个 alias 与资源的对照

            · `.icon.Check`：`@mipmap/ic_launcher_check`，前景 `@drawable/ic_icon_fore_check`，底色 `#00ACC1`
            · `.icon.Star`：`@mipmap/ic_launcher_star`，前景 `@drawable/ic_icon_fore_star`，底色 `#37474F`
            · `.icon.Flame`：`@mipmap/ic_launcher_flame`，前景 `@drawable/ic_icon_fore_flame`，底色 `#E53935`
            · `.icon.Leaf`：`@mipmap/ic_launcher_leaf`，前景 `@drawable/ic_icon_fore_leaf`，底色 `#43A047`

            ## ⚠️ `enabled="false"` 与 `roundIcon` 一个都不能少

            - `enabled="false"`：安装后的初始状态必须只有 `.icon.Default` 是启用的，
              否则桌面会**同时出现多个图标**（每个启用的 LAUNCHER alias 都是一个图标），
              而且与 `SettingsRepository.DEFAULT_ICON_STYLE`（`"default"`）矛盾。
            - `android:roundIcon`：alias 的图标取自**它自己的属性数组**，
              `roundIcon` 优先于 `icon`；漏写时在查询 roundIcon 的桌面（三星 / 部分 EMUI）
              上会回落到从 `.MainActivity` 继承的图标，表现为"应用内切了、桌面没变"。
              这四个 alias 的 `roundIcon` 与 `icon` 指向**同一个自适应图标 XML**：
              自适应图标由桌面按自己的形状去裁，圆形与方形两份文件内容会逐字节相同。
            - 类名的**首字母大写**不是风格问题：`AppIconRepository.aliasComponentOf`
              的兜底路径按 id 首字母大写拼类名，改名会让那条路径失效。
        -->
        <activity-alias
            android:name=".icon.Check"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_check"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_check"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Star"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_star"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_star"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Flame"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_flame"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_flame"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".icon.Leaf"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_leaf"
            android:label="@string/app_name"
            android:roundIcon="@mipmap/ic_launcher_leaf"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
